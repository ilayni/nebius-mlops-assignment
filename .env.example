# Copy to .env and fill in values. Never commit .env.
# Local dev (Token Factory): set OPENAI_BASE_URL to the ToFa endpoint, OPENAI_API_KEY to your ToFa key.
# H100: set OPENAI_BASE_URL=http://localhost:8000/v1, OPENAI_API_KEY=EMPTY (vLLM needs no auth).

OPENAI_BASE_URL=
OPENAI_API_KEY=

VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct

# Self-hosted Langfuse (docker-compose spins this up on :3001)
# Keys are pre-seeded in docker-compose.yml — no manual creation needed
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-2222-3333-4444-555555555555
LANGFUSE_SECRET_KEY=sk-lf-66666666-7777-8888-9999-aaaaaaaaaaaa
LANGFUSE_HOST=http://localhost:3001
